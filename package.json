{
	"name": "dss-leaderboard",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check && tsc --noEmit && tsc -p functions",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"pages:dev": "astro build && wrangler pages dev",
		"verify": "npm run format:check && npm run lint && npm run check && npm test && npm run build",
		"seed": "node scripts/seed.mjs"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.4",
		"astro": "^7.4.5",
		"tailwindcss": "^4.3.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@cloudflare/workers-types": "^5.20261104.1",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0",
		"wrangler": "^4.157.0"
	}
}
