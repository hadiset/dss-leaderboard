---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Leaderboard Sekolah Seller">
	<main class="mx-auto w-full max-w-2xl px-4 py-6 sm:py-10">
		<header>
			<p id="judul" class="text-sm font-semibold text-indigo-700">
				Sekolah Seller
			</p>
			<div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
				<h1 id="periode" class="text-3xl font-bold tracking-tight">
					Leaderboard
				</h1>
				<span
					id="sementara"
					hidden
					class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900"
				>
					Sementara
				</span>
			</div>
			<p id="diperbarui" class="mt-2 min-h-5 text-sm text-slate-600"></p>
			<p id="keterangan" hidden class="mt-1 text-sm text-slate-600">
				Angka masih bisa berubah karena retur atau koreksi.
			</p>
			<p id="usang" hidden class="mt-1 text-sm font-medium text-amber-800"></p>
		</header>

		<div id="pilih-periode" hidden class="mt-5">
			<label for="pilihan-periode" class="mb-1 block text-sm font-medium text-slate-700">
				Periode
			</label>
			<select
				id="pilihan-periode"
				class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-base focus:border-indigo-600 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
			></select>
		</div>

		<div
			id="pesan"
			hidden
			role="alert"
			class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900"
		>
			<p id="pesan-teks"></p>
			<button
				id="coba-lagi"
				type="button"
				class="min-h-11 rounded-lg bg-red-800 px-4 font-semibold text-white hover:bg-red-900 disabled:opacity-60"
			>
				Coba lagi
			</button>
		</div>

		<div id="skeleton" class="mt-6 space-y-3" aria-hidden="true">
			<div class="h-20 animate-pulse rounded-xl bg-slate-200"></div>
			<div class="h-20 animate-pulse rounded-xl bg-slate-200"></div>
			<div class="h-20 animate-pulse rounded-xl bg-slate-200"></div>
			<div class="h-12 animate-pulse rounded-xl bg-slate-200"></div>
			<div class="h-12 animate-pulse rounded-xl bg-slate-200"></div>
		</div>

		<p id="kosong" hidden class="mt-8 text-center text-slate-600">
			Belum ada data untuk periode ini
		</p>

		<div id="pencarian" hidden class="mt-6">
			<label for="cari" class="sr-only">
				Cari nama
			</label>
			<input
				id="cari"
				type="search"
				placeholder="Cari nama"
				autocomplete="off"
				class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-4 text-base placeholder:text-slate-500 focus:border-indigo-600 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
			/>
		</div>

		<section id="konten" hidden class="mt-5" aria-label="Peringkat">
			<ol id="top3" class="grid gap-3 sm:grid-cols-3"></ol>

			<div id="tabel" class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white">
				<div class="grid grid-cols-[3rem_minmax(0,1fr)_auto] gap-3 border-b border-slate-200 bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-600">
					<span>Rank</span>
					<span>Nama</span>
					<span class="text-right">Nilai bersih</span>
				</div>
				<ol id="daftar" class="divide-y divide-slate-100"></ol>
			</div>

			<p id="tanpa-hasil" hidden class="mt-6 text-center text-slate-600">
				Tidak ada nama yang cocok
			</p>
		</section>

		<footer class="mt-8 space-y-1 text-center text-xs text-slate-600">
			<p>Data biasanya diperbarui siang dan sore.</p>
		</footer>
	</main>

	<template id="template-kartu">
		<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm data-[rank=1]:border-amber-300 data-[rank=1]:bg-amber-50 data-[rank=2]:border-slate-300 data-[rank=2]:bg-slate-100 data-[rank=3]:border-orange-300 data-[rank=3]:bg-orange-50">
			<p class="text-sm font-semibold text-slate-700">
				Rank <span data-field="rank" class="text-2xl font-bold text-slate-900"></span>
			</p>
			<p data-field="nama" class="mt-1 font-semibold wrap-anywhere"></p>
			<p data-field="nilai" class="mt-1 text-lg font-bold text-indigo-800 tabular-nums"></p>
		</li>
	</template>

	<template id="template-baris">
		<li class="grid grid-cols-[3rem_minmax(0,1fr)_auto] items-center gap-3 px-4 py-3 text-sm">
			<span data-field="rank" class="font-semibold text-slate-600 tabular-nums"></span>
			<span data-field="nama" class="font-medium wrap-anywhere"></span>
			<span data-field="nilai" class="text-right font-semibold tabular-nums"></span>
		</li>
	</template>

	<script src="../scripts/leaderboard.ts"></script>
</Layout>
